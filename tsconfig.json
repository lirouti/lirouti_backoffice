{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "skipLibCheck": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    "paths": {
      "@/*": ["./src/*"],
      "styled-system/*": ["./styled-system/*"]
    }
  },
  "include": ["src", "styled-system", "scripts", "vite.config.ts", "panda.config.ts"],
  // 접근성 검사는 의존성을 따로 갖는 미니 프로젝트다 (docs/ARCHITECTURE.md §38.3).
  // 깨끗한 클론에는 그 `node_modules` 가 없어서, 여기 두면 `typecheck` 이 못 푼다.
  "exclude": ["scripts/a11y"]
}
